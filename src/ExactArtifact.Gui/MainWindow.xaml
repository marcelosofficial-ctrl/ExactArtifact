<Window x:Class="ExactArtifact.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ExactArtifact"
        Width="820"
        Height="680"
        MinWidth="700"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="22"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="EXACTARTIFACT"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="Prove the bytes."
                           FontSize="30"
                           FontWeight="SemiBold"
                           Margin="0,5,0,0"/>
                <TextBlock Text="Local SHA-256 verification for files and release folders."
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="14"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="12,6"
                    VerticalAlignment="Top">
                <TextBlock Text="LOCAL ONLY"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{StaticResource SecondaryTextBrush}"/>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="24">
            <TabControl Background="Transparent"
                        BorderThickness="0">
                <TabItem Header="FILE">
                    <Grid Margin="0,22,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="File"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FilePathBox"
                                         IsReadOnly="True"
                                         MinHeight="42"
                                         ToolTip="Drop a file anywhere on this window, or browse."/>
                                <Button Grid.Column="2"
                                        Content="Browse"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="BrowseFile_Click"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="Expected SHA-256 (optional)"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>
                            <TextBox x:Name="ExpectedHashBox"
                                     MinHeight="42"
                                     TextChanged="ExpectedHashBox_TextChanged"
                                     ToolTip="Paste an expected SHA-256 to compare automatically."/>
                        </StackPanel>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="HashButton"
                                    Content="Calculate SHA-256"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="Hash_Click"/>
                            <Button Grid.Column="2"
                                    x:Name="CopyHashButton"
                                    Content="Copy hash"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="CopyHash_Click"
                                    IsEnabled="False"/>
                            <Button Grid.Column="4"
                                    x:Name="CancelHashButton"
                                    Content="Cancel"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="CancelHash_Click"
                                    IsEnabled="False"/>
                        </Grid>

                        <Border Grid.Row="6"
                                Background="{StaticResource InputBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16">
                            <StackPanel>
                                <TextBlock x:Name="FileStatusLabel"
                                           Text="READY"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBlock x:Name="FileNameLabel"
                                           Text="No file selected"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Margin="0,8,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="HashLabel"
                                           Text="SHA-256 will appear here."
                                           FontFamily="Consolas"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="FileMetaLabel"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <ProgressBar Grid.Row="8"
                                     x:Name="FileProgress"
                                     Height="3"
                                     IsIndeterminate="True"
                                     Visibility="Collapsed"
                                     Background="#22252B"
                                     Foreground="{StaticResource AccentBrush}"/>
                    </Grid>
                </TabItem>

                <TabItem Header="FOLDER MANIFEST">
                    <Grid Margin="0,22,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Folder"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FolderPathBox"
                                         IsReadOnly="True"
                                         MinHeight="42"/>
                                <Button Grid.Column="2"
                                        Content="Browse"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="BrowseFolder_Click"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="Manifest"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ManifestPathBox"
                                         MinHeight="42"/>
                                <Button Grid.Column="2"
                                        Content="Browse"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="BrowseManifest_Click"/>
                            </Grid>
                        </StackPanel>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="CreateManifestButton"
                                    Content="Create manifest"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="CreateManifest_Click"/>
                            <Button Grid.Column="2"
                                    x:Name="VerifyManifestButton"
                                    Content="Verify folder"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="VerifyManifest_Click"/>
                            <Button Grid.Column="4"
                                    x:Name="CancelManifestButton"
                                    Content="Cancel"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="CancelManifest_Click"
                                    IsEnabled="False"/>
                        </Grid>

                        <Border Grid.Row="6"
                                Background="{StaticResource InputBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="ManifestStatusLabel"
                                           Text="READY"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBox Grid.Row="2"
                                         x:Name="ManifestResultBox"
                                         Text="Choose a folder and create or verify a deterministic manifest."
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="0"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Foreground="{StaticResource SecondaryTextBrush}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="No uploads. No accounts. No telemetry."
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="12"/>
            <TextBlock Grid.Column="1"
                       Text="1.0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="12"/>
        </Grid>
    </Grid>
</Window>